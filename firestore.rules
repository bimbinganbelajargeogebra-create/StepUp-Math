rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and subcollections access
    match /users/{userId} {
      allow read, write: if true;
      
      match /levelProgress/{levelId} {
        allow read, write: if true;
      }
      
      match /sessions/{sessionId} {
        allow read, write: if true;
      }
      
      match /pretest/{pretestId} {
        allow read, write: if true;
      }
    }
    
    // Root level collections for cross-device sync & leaderboard
    match /levelProgress/{progressId} {
      allow read, write: if true;
    }
    
    match /sessionHistory/{sessionId} {
      allow read, write: if true;
    }
    
    match /pretestResults/{resultId} {
      allow read, write: if true;
    }

    match /reflectionJournals/{journalId} {
      allow read, write: if true;
    }

    match /studentBadges/{studentId} {
      allow read, write: if true;
    }
    
    // User accounts and registration requests
    match /accounts/{accountUsername} {
      allow read, write: if true;
    }

    // Ping / Diagnostic connection test collection
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
